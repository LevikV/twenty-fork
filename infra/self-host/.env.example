# Конфигурация боевого контура Twenty CRM (Kplus79).
# Скопировать в /opt/twenty-crm/self-host/.env и заполнить секреты.
# Значения секретов: openssl rand -base64 32

# Образ: тег собирается scripts/release.sh (см. README в корне репозитория)
TAG=notify-v91

# Центр уведомлений: true — писать историю в «Уведомления», false — только пуши
NOTIFY_PERSIST=true

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<секрет>
#PG_DATABASE_HOST=db
#PG_DATABASE_PORT=5432
#REDIS_URL=redis://redis:6379

SERVER_URL=https://crm.kplus79.ru

ENCRYPTION_KEY=<секрет>
#FALLBACK_ENCRYPTION_KEY=<старый ключ на время ротации>
#APP_SECRET=<секрет>

STORAGE_TYPE=local
# STORAGE_S3_REGION=
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Выполнение логик-функций приложений на воркере (LOCAL — внутри контейнера)
LOGIC_FUNCTION_TYPE=LOCAL

# Временно, на время миграции истории звонков (снять после):
APPLICATION_API_RATE_LIMITING_LIMIT=10000
APPLICATION_API_RATE_LIMITING_TTL_IN_MS=60000

# Токен подключения телефонов к приватному SMS-шлюзу (экран «Мои каналы»)
SMS_GATEWAY_PRIVATE_TOKEN=<секрет>
# Подпись входящих вебхуков SMS-шлюза. Пусто — подпись не проверяется.
SMS_WEBHOOK_SECRET=<секрет>
# Секрет в адресе входящего вебхука SMS (?k=...)
SMS_INBOUND_SECRET=<секрет>
