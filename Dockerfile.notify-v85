# v85: колокольчик уведомлений и кнопка «Центр коммуникации» перенесены
# из патча собранного бандла в исходники (modules/notification-bell) и
# рендерятся в PageCardHeader. Функциональность прежняя:
#   колокольчик — /api/notify/mine (список, «Показать ещё»), /api/notify/read,
#                 /api/notify/read-all, обновление раз в 60 с;
#   кнопка чата — /api/notify/chat-unread (раз в 5 с), /api/notify/chat-list,
#                 переход на страницу «Центр коммуникации».
# База — notify-v84 (в нём уже новый фронт с морф-фильтром и обновлённый twenty-shared).
FROM twentycrm/twenty:notify-v84

USER root

RUN rm -rf /app/packages/twenty-server/dist/front
COPY build-context-v85/front /app/packages/twenty-server/dist/front
RUN chown -R node:node /app/packages/twenty-server/dist/front

USER node
