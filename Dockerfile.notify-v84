# v84: фильтр по морф-полю «Покупатель» в журналах (Заказы / Ремонты / Заправки / Тендеры).
# База — notify-v83. Изменения:
#   1) фронт — MORPH_RELATION добавлен в фильтруемые поля; пикер значения делится на секции
#      по целям морф-связи (Компании / Контакты), подпись чипа собирается из всех целей;
#   2) twenty-shared — фильтр морф-связи строится по всем join-столбцам
#      (is / is not / empty / not empty) вместо единственного столбца текущей записи.
FROM twentycrm/twenty:notify-v83

USER root

RUN rm -rf /app/packages/twenty-server/dist/front
COPY build-context-v84/front /app/packages/twenty-server/dist/front

RUN rm -rf /app/packages/twenty-shared/dist
COPY build-context-v84/shared /app/packages/twenty-shared/dist

RUN chown -R node:node \
      /app/packages/twenty-server/dist/front \
      /app/packages/twenty-shared/dist

USER node
