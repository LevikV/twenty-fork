# v52: фронт с колокольчиком на cookie-авторизации (без Bearer)
FROM twentycrm/twenty:notify-v50

USER root

RUN rm -rf /app/packages/twenty-server/dist/front
COPY build-context-v52/front /app/packages/twenty-server/dist/front
RUN chown -R node:node /app/packages/twenty-server/dist/front

USER node
